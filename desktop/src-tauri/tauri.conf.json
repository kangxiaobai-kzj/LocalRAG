{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalRAG",
  "version": "1.0.0",
  "identifier": "com.kangxiaobai.localrag",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
